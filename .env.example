# MongoDB Atlas o instancia local
MONGODB_URI=mongodb://127.0.0.1:27017/autoescan

# Auth.js — genera con: openssl rand -base64 32
AUTH_SECRET=
# En producción: URL pública del sitio (ej. https://autoescan.vercel.app)
# AUTH_URL=https://tu-dominio.com

# Google AI Studio — https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=

# Opcional (default: gemini-2.5-flash)
# Alternativas: gemini-2.5-flash-lite, gemini-flash-latest
GEMINI_MODEL=gemini-2.5-flash

# Búsqueda de fotos de productos (API Python en Railway)
FAST_API_KEY=
# Opcional — override del endpoint
# IMAGE_SEARCH_API_URL=https://python-scripts-production-9406.up.railway.app/api/search

# ImageKit — hosting de fotos de productos (folder /autoescan)
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/tu_id

# WhatsApp de soporte AutoEscán (obligatorio en producción)
# AUTOESCAN_SUPPORT_WHATSAPP=+5939XXXXXXXXX

# Correos legales / contacto (aparecen en /privacidad y /terminos)
# AUTOESCAN_SUPPORT_EMAIL=hola@tudominio.com
# AUTOESCAN_PRIVACY_EMAIL=privacidad@tudominio.com
# URL canónica para sitemap/robots (si no usas AUTH_URL)
# NEXT_PUBLIC_SITE_URL=https://tudominio.com

# Cron diario de alertas de stock (Vercel Cron → Authorization: Bearer …)
# Genera con: openssl rand -base64 32
# CRON_SECRET=

# Stripe Checkout (planes / impulsos). Sin clave → checkout manual + simulación en dev.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# BILLING_ALLOW_SIMULATE=1

# WhatsApp en catálogo público
# Soft prompt tras clic (default ON). Pon 0 para silenciarlo.
# NEXT_PUBLIC_WHATSAPP_SOFT_PROMPT=0
# Hard gate: exigir login para contactar (default OFF). Pon 1 para activar.
# NEXT_PUBLIC_WHATSAPP_REQUIRE_LOGIN=1
